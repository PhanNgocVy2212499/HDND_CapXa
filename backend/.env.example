# Firebase Admin
FIREBASE_PROJECT_ID=hdnd-xa-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@hdnd-xa-demo.iam.gserviceaccount.com
# Private key giữ nguyên định dạng \n (không commit file thật lên git)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=hdnd-xa-demo.appspot.com

# Google Cloud Vision (dùng chung service account ở trên, hoặc file key riêng)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=5000
CLIENT_URL=http://localhost:3000

# Storage: firebase | local | cloudinary
STORAGE_MODE=firebase

# Cloudinary (chỉ cần khi STORAGE_MODE=cloudinary; PDF lưu dạng raw)
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx
