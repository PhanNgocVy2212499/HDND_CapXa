# Mẫu biến môi trường cho Frontend (Vite)
# Copy file này thành .env hoặc .env.development:
# cp .env.example .env

# URL API Backend Express
VITE_API_URL=http://localhost:5000/api

# Cấu hình Firebase Client SDK (Web App)
# Lấy tại: Firebase Console -> Project settings -> General -> Your apps (Web) -> firebaseConfig
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456
VITE_FIREBASE_AUTH_DOMAIN=hdnd-xa-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hdnd-xa-demo
VITE_FIREBASE_STORAGE_BUCKET=hdnd-xa-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

